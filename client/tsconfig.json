{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@xapps/sdk": ["./src/sdk/index.ts"],
      "@xapps/sdk/react": ["./src/sdk/react.tsx"],
      "@xapps/sdk/host": ["./src/sdk/host.ts"],
      "@xapps/sdk/protocol": ["./src/sdk/protocol.ts"]
    }
  },
  "include": ["src"]
}
